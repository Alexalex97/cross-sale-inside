add_shortcode( 'color_variants_table', 'display_cross_sells_as_table_shortcode' );

function display_cross_sells_as_table_shortcode() {
    global $product;

    if ( ! is_a( $product, 'WC_Product' ) ) {
        return '';
    }

    $cross_sell_ids = $product->get_cross_sell_ids();

    if ( empty( $cross_sell_ids ) ) {
        return '';
    }

    // Support for Variations: We include product_variation post type
    $args = array(
        'post_type'      => array( 'product', 'product_variation' ),
        'post__in'       => $cross_sell_ids,
        'orderby'        => 'post__in', // Uses the order they were added to the box
        'posts_per_page' => -1,
        'post_status'    => array( 'publish', 'private' )
    );

    $ordered_query = new WP_Query( $args );

    ob_start();
    ?>
    <style>
        .color-table-wrapper { 
            margin-top: 20px; 
            max-height: 400px; 
            overflow-y: auto !important; 
            -webkit-overflow-scrolling: touch; 
            border: 1px solid #333; 
            background: #fff;
        }
        .color-table-wrapper::-webkit-scrollbar { width: 8px !important; display: block !important; }
        .color-table-wrapper::-webkit-scrollbar-track { background: #f1f1f1 !important; }
        .color-table-wrapper::-webkit-scrollbar-thumb { background: #888 !important; border-radius: 4px !important; }

        .color-table-wrapper table { width: 100%; border-collapse: collapse; color: black; margin: 0; }
        .color-table-wrapper th { 
            text-align: left; 
            border-bottom: 2px solid #eee; 
            padding: 10px; 
            position: sticky; 
            top: 0; 
            background: #fff; 
            z-index: 10;
        }
        .color-table-wrapper td { padding: 9px 4px!important; border-bottom: 1px solid #eee; vertical-align: middle; }
        .color-table-wrapper th:nth-child(2), .color-table-wrapper td:nth-child(2),
        .color-table-wrapper th:nth-child(3), .color-table-wrapper td:nth-child(3) { text-align: center; }

        .color-table-wrapper .cart-form { display: flex; align-items: center; gap: 8px; justify-content: center; }
        .color-table-wrapper .qty-input { width: 55px; height: 32px; text-align: center; border: 1px solid #ccc; border-radius: 3px; }
        .color-table-wrapper .add-btn { background: #000; color: #fff; padding: 5px 15px; border-radius: 3px; border: none; cursor: pointer; font-size: 14px; white-space: nowrap; }
        
        /* Out of stock text styling */
        .color-table-wrapper .out-of-stock-msg { color: #d9534f; font-weight: 600; font-size: 14px; white-space: nowrap; }

        /* Efect de hover pe titlul produsului pentru a indica faptul că e clickuibil */
        .color-table-wrapper .product-title-link:hover { text-decoration: underline; }

        @media screen and (max-width: 600px) {
            .color-table-wrapper .cart-form { flex-direction: column; gap: 5px; }
            .color-table-wrapper .qty-input { width: 100%; max-width: 75px; }
            .color-table-wrapper .add-btn { width: 100%; max-width: 80px; font-size: 13px; padding: 6px 10px; }
            .color-table-wrapper td { padding: 5px !important; }
            .color-table-wrapper .out-of-stock-msg { font-size: 13px; }
        }
    </style>

    <h3 style="color:white;">Din aceeași serie</h3>
    <div class="color-table-wrapper">
        <table class="shop_table color-variation-table">
            <thead>
                <tr>
                    <th>Tip</th>
                    <th>Preț</th>
                    <th>Acțiune</th>
                </tr>
            </thead>
            <tbody>
                <?php
                if ( $ordered_query->have_posts() ) :
                    while ( $ordered_query->have_posts() ) : $ordered_query->the_post();
                        $current_id = get_the_ID();
                        $current_product = wc_get_product( $current_id );
                        
                        if ( ! $current_product ) continue;

                        $display_name = $current_product->get_name();
                        ?>
                        <tr>
                            <td>
                                <div style="display:flex; align-items:center; gap:10px; font-weight:600;">
                                    <?php echo $current_product->get_image( array( 40, 40 ) ); ?>
                                    <a href="<?php echo esc_url( $current_product->get_permalink() ); ?>" class="product-title-link" style="color: inherit; text-decoration: none;">
                                        <?php echo esc_html( $display_name ); ?>
                                    </a>
                                </div>
                            </td>
                            <td><?php echo $current_product->get_price_html(); ?></td>
                            <td>
                                <?php if ( $current_product->is_in_stock() ) : ?>
                                    <form class="cart-form" action="" method="post" enctype="multipart/form-data">
                                        <input type="number" name="quantity" value="1" min="1" class="qty-input">
                                        <button type="submit" name="add-to-cart" value="<?php echo esc_attr( $current_id ); ?>" class="add-btn">
                                           Adaugă
                                        </button>
                                    </form>
                                <?php else : ?>
                                    <span class="out-of-stock-msg">Stoc epuizat</span>
                                <?php endif; ?>
                            </td>
                        </tr>
                        <?php
                    endwhile;
                    wp_reset_postdata();
                endif;
                ?>
            </tbody>
        </table>
    </div>
    <?php
    return ob_get_clean();
}
